{
  "name": "MedicationReminder",
  "type": "object",
  "properties": {
    "prescription_id": {
      "type": "string",
      "description": "ID of the associated prescription"
    },
    "patient_name": {
      "type": "string",
      "description": "Name of the patient this reminder is for"
    },
    "medicine_name": {
      "type": "string",
      "description": "Name of the medicine"
    },
    "dosage": {
      "type": "string",
      "description": "Dosage amount"
    },
    "frequency": {
      "type": "string",
      "description": "How often to take"
    },
    "timing": {
      "type": "string",
      "description": "When to take (e.g., after meals)"
    },
    "reminder_times": {
      "type": "array",
      "description": "Array of reminder times in HH:MM format",
      "items": {
        "type": "string"
      }
    },
    "duration_days": {
      "type": "number",
      "description": "How many days to take the medicine"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When to start taking the medicine"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "When to stop taking the medicine"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the reminder is active"
    },
    "category": {
      "type": "string",
      "enum": [
        "antibiotic",
        "painkiller",
        "vitamin",
        "supplement",
        "chronic",
        "other"
      ],
      "description": "Medicine category"
    },
    "quantity_prescribed": {
      "type": "number",
      "description": "Total quantity of medicine prescribed (e.g., 30 pills)"
    },
    "refill_reminder_date": {
      "type": "string",
      "format": "date",
      "description": "Date to remind user for a refill"
    }
  },
  "required": [
    "prescription_id",
    "patient_name",
    "medicine_name",
    "reminder_times"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}