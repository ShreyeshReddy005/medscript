{
  "name": "Prescription",
  "type": "object",
  "properties": {
    "doctor_name": {
      "type": "string",
      "description": "Name of the prescribing doctor"
    },
    "clinic_name": {
      "type": "string",
      "description": "Name of the clinic or hospital"
    },
    "hospital_name": {
      "type": "string",
      "description": "Name of the hospital"
    },
    "doctor_phone": {
      "type": "string",
      "description": "Doctor's contact phone number"
    },
    "clinic_address": {
      "type": "string",
      "description": "Clinic or hospital address"
    },
    "patient_name": {
      "type": "string",
      "description": "Full name of the patient. Must match User.full_name, User.preferred_name, or FamilyMember.full_name exactly."
    },
    "prescription_date": {
      "type": "string",
      "format": "date",
      "description": "Date when prescription was issued"
    },
    "medicines": {
      "type": "array",
      "description": "List of prescribed medicines",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "strength": {
            "type": "string",
            "description": "e.g. 500mg, 10mg/5ml, 25mcg"
          },
          "generic_name": {
            "type": "string"
          },
          "dosage": {
            "type": "string",
            "description": "e.g. 1 tablet, 2 drops"
          },
          "frequency": {
            "type": "string",
            "description": "e.g. Twice daily, Three times daily"
          },
          "timing": {
            "type": "string",
            "description": "e.g. After meals, Before breakfast"
          },
          "duration": {
            "type": "string",
            "description": "e.g. 7 days, 1 month"
          },
          "instructions": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "antibiotic",
              "painkiller",
              "vitamin",
              "supplement",
              "chronic",
              "other"
            ]
          }
        }
      }
    },
    "diagnosis": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "original_file_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "drug_interactions": {
      "type": "array",
      "description": "Known drug interactions detected at scan time",
      "items": {
        "type": "object",
        "properties": {
          "drug_a": {
            "type": "string"
          },
          "drug_b": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "mild",
              "moderate",
              "severe"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "medicines",
    "patient_name"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}